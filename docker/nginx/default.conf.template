limit_req_zone $binary_remote_addr zone=api_write:10m rate=45r/m;
limit_req_zone $binary_remote_addr zone=api_read:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=api_stats:10m rate=240r/m;
limit_req_status 429;

server {
    listen       ${NGINX_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;
    client_max_body_size 11m;
    server_tokens off;

    error_page 404 /404.html;

    location = /404.html {
        internal;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers.conf;
    }

    location ~* \.(?:woff2|woff|ttf|otf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/1time-security-headers.conf;
        access_log off;
        try_files $uri =404;
    }

    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/1time-security-headers.conf;
        access_log off;
        try_files $uri =404;
    }

    location = /api/saveSecret {
        limit_req zone=api_write burst=10 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers.conf;
        proxy_hide_header Server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    location = /api/get {
        limit_req zone=api_read burst=15 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers.conf;
        proxy_hide_header Server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    location = /api/stat {
        limit_req zone=api_stats burst=30 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers.conf;
        proxy_hide_header Server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    location /api/ {
        limit_req zone=api_read burst=15 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers.conf;
        proxy_hide_header Server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    location = /v/ {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers-sensitive.conf;
        try_files $uri $uri/ /index.html =404;
    }

    location = /f/ {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers-sensitive.conf;
        try_files $uri $uri/ /index.html =404;
    }

    location / {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/1time-security-headers.conf;
        try_files $uri $uri/ /index.html =404;
    }
}
