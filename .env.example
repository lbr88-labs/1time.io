# Required
# DATA_DIR stores both Redis persistence and encrypted uploaded files.
DATA_DIR=./data
APP_HOSTNAME=secrets.example.com

# Pin to images published from your own fork. Prefer digest pins after the
# workflow publishes them to GHCR.
BACKEND_IMAGE=ghcr.io/lbr88/1time-backend@sha256:replace-with-backend-digest
WEB_IMAGE=ghcr.io/lbr88/1time-web@sha256:replace-with-web-digest

# Optional
APP_PORT=8080
SHOW_BLOG=false
